{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build STM32 (Make)",
            "type": "shell",
            "command": "make",
            "args": ["all"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "/opt/arm-gnu-toolchain-15.2.rel1-x86_64-arm-none-eabi/bin:${env:PATH}"
                }
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Clean STM32",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Flash STM32 (Make flash)",
            "type": "shell",
            "command": "make",
            "args": ["flash"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "/opt/arm-gnu-toolchain-15.2.rel1-x86_64-arm-none-eabi/bin:${env:PATH}"
                }
            },
            "problemMatcher": []
        }
    ]
}
